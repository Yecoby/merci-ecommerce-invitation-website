// This is your Prisma schema file for MERCI Digital Invitations Platform.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema
//
// Purpose of each model is documented inline.
// Monetary values are stored as integer minor units (centavos) to avoid float errors.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  // Development: SQLite (zero-config, no server needed).
  // Production: change provider to "postgresql" and update DATABASE_URL.
  // To switch: update this file's provider + DATABASE_URL, then run `prisma migrate deploy`.
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// AUTH MODELS (required by Auth.js / next-auth v5 with Prisma adapter)
// ---------------------------------------------------------------------------

/// Platform user — both customers and administrators.
/// Roles are controlled server-side only; clients cannot self-elevate.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CUSTOMER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Auth.js relations
  accounts      Account[]
  sessions      Session[]

  // Business relations
  customerProfile CustomerProfile?
  invitations     Invitation[]
  orders          Order[]
  rsvps           RSVP[]
  auditLogs       AuditLog[]

  @@index([email])
  @@index([role])
}

/// OAuth / credential accounts linked to a User (Auth.js requirement).
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

/// Database sessions (Auth.js requirement when using database sessions).
model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Email-verification and password-reset tokens (Auth.js requirement).
model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// CUSTOMER PROFILE
// ---------------------------------------------------------------------------

/// Extended profile information for customers.
/// Kept separate from User so auth models stay clean.
model CustomerProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  phone       String?
  preferredContact String? // e.g. "messenger", "viber", "email"
  notes       String?  // internal admin notes only
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// TEMPLATE ENGINE
// ---------------------------------------------------------------------------

/// Occasion categories for filtering templates.
model TemplateCategory {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())

  templates Template[]

  @@index([slug])
  @@index([isActive])
}

/// A reusable invitation template design.
/// Design configuration is stored as JSON; the application layer validates it.
model Template {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  tagline     String
  description String
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  categoryId  String
  category    TemplateCategory @relation(fields: [categoryId], references: [id])

  // Current version pointer
  currentVersionId String?   @unique
  currentVersion   TemplateVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id])

  versions  TemplateVersion[] @relation("AllVersions")
  invitations Invitation[]

  @@index([slug])
  @@index([isActive])
  @@index([categoryId])
}

/// Immutable version snapshot of a template design.
/// Existing invitations pin to a specific version so layout updates do not break them.
model TemplateVersion {
  id              String   @id @default(cuid())
  version         Int
  /// JSON: { palette, typography, sections, customizableFields }
  designConfig    String
  /// JSON: list of supported feature keys
  supportedFeatures String
  releaseNotes    String?
  createdAt       DateTime @default(now())

  templateId String
  template   Template @relation("AllVersions", fields: [templateId], references: [id], onDelete: Cascade)

  // Back-reference: if this version is the template's current version
  templateCurrent Template? @relation("CurrentVersion")
  invitations     Invitation[]

  @@unique([templateId, version])
  @@index([templateId])
}

// ---------------------------------------------------------------------------
// INVITATION
// ---------------------------------------------------------------------------

/// One customer's live invitation instance, tied to a template version.
/// Tracks separate lifecycle states from draft → published.
model Invitation {
  id               String           @id @default(cuid())
  /// Unguessable public slug for the shareable URL /i/[publicSlug]
  publicSlug       String           @unique @default(cuid())
  title            String
  status           InvitationStatus @default(DRAFT)
  isPublic         Boolean          @default(false)
  publishedAt      DateTime?
  archivedAt       DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  ownerId          String
  owner            User             @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  templateId       String
  template         Template         @relation(fields: [templateId], references: [id])

  templateVersionId String
  templateVersion   TemplateVersion @relation(fields: [templateVersionId], references: [id])

  // Event data (all nullable; populated progressively by the builder)
  eventData        EventData?
  rsvpConfig       RSVPConfig?
  images           InvitationImage[]
  rsvps            RSVP[]
  order            Order?

  @@index([ownerId])
  @@index([publicSlug])
  @@index([status])
  @@index([templateId])
}

/// The event information attached to an invitation.
/// Stored as a separate record for clean separation of data vs. design.
model EventData {
  id             String   @id @default(cuid())
  invitationId   String   @unique

  hosts          String   // comma-separated names or JSON
  eventDate      DateTime?
  endDate        DateTime?
  timeZone       String   @default("Asia/Manila")
  venueName      String?
  venueAddress   String?
  venueMapUrl    String?
  welcomeMessage String?
  /// JSON: Array<{ time: string; activity: string }>
  schedule       String?
  dressCode      String?
  rsvpDeadline   DateTime?
  contactDetails String?  // JSON
  musicUrl       String?  // admin-curated only
  updatedAt      DateTime @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

/// Guest-uploaded or admin-uploaded images for an invitation.
model InvitationImage {
  id           String   @id @default(cuid())
  invitationId String
  storageKey   String   // path in object storage or local
  altText      String?
  sortOrder    Int      @default(0)
  isPublic     Boolean  @default(false)
  createdAt    DateTime @default(now())

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)

  @@index([invitationId])
}

// ---------------------------------------------------------------------------
// RSVP SYSTEM
// ---------------------------------------------------------------------------

/// Host-configurable RSVP settings per invitation.
model RSVPConfig {
  id                   String   @id @default(cuid())
  invitationId         String   @unique
  isEnabled            Boolean  @default(true)
  deadline             DateTime?
  maxGuests            Int?     // total capacity across all RSVPs
  allowPlusOne         Boolean  @default(false)
  requireAttendeeNames Boolean  @default(false)
  enableMealChoice     Boolean  @default(false)
  /// JSON: string[] of meal options
  mealOptions          String?
  customMessage        String?
  updatedAt            DateTime @updatedAt

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
}

/// A guest's RSVP submission for a published invitation.
model RSVP {
  id             String         @id @default(cuid())
  invitationId   String
  /// Optional link to a registered user; many guests will be anonymous
  userId         String?
  guestName      String
  email          String?
  response       RSVPResponse
  attendeeCount  Int            @default(1)
  /// JSON: string[] of attendee names (when required by config)
  attendeeNames  String?
  mealChoice     String?
  dietaryNotes   String?
  message        String?
  submittedAt    DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  /// Prevents accidental duplicate submissions on the same device
  submissionHash String?

  invitation Invitation @relation(fields: [invitationId], references: [id], onDelete: Restrict)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([invitationId])
  @@index([userId])
  @@index([submittedAt])
}

// ---------------------------------------------------------------------------
// INQUIRY & ORDER WORKFLOW
// ---------------------------------------------------------------------------

/// Customer inquiry submitted through the custom invitation form.
/// First step of the custom-service workflow.
model Inquiry {
  id               String        @id @default(cuid())
  customerName     String
  email            String
  phone            String?
  eventType        String
  eventDate        DateTime?
  preferredStyle   String?
  approxGuestCount Int?
  desiredFeatures  String?
  budgetRange      String?
  notes            String?
  privacyAgreed    Boolean
  submittedAt      DateTime      @default(now())
  status           InquiryStatus @default(NEW)
  // Linked order once created from this inquiry
  orderId          String?       @unique

  order Order? @relation(fields: [orderId], references: [id])

  @@index([email])
  @@index([status])
  @@index([submittedAt])
}

/// An order links a customer, invitation, and payment lifecycle together.
/// Supports both self-service (template purchase) and custom-service workflows.
model Order {
  id             String       @id @default(cuid())
  /// Human-readable order reference (e.g. MERCI-2027-0001)
  reference      String       @unique
  customerId     String
  invitationId   String?      @unique
  type           OrderType
  status         OrderStatus  @default(INQUIRY)
  /// Amount in integer minor units (centavos). NULL until quotation is confirmed.
  amountCentavos Int?
  currency       String       @default("PHP")
  notes          String?      // customer-visible notes
  internalNotes  String?      // admin-only notes
  revisionLimit  Int          @default(2)
  revisionCount  Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Client Portal Access fields
  accessCodeHash String?      // SHA-256 hash of high-entropy portal code (e.g. MRC-XXXX)
  accessCodeHint String?      // e.g. "MRC-••98" for friendly display to admin
  briefingData   String?      // Rich JSON event briefing data autosaved by customer
  briefingStatus String       @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, SUBMITTED
  packageSlug    String       @default("self-service") // self-service, custom-concierge, bespoke-atelier

  customer   User        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  invitation Invitation? @relation(fields: [invitationId], references: [id])
  inquiry    Inquiry?
  quotations Quotation[]
  payments   PaymentRecord[]
  revisions  RevisionRequest[]
  statusLogs OrderStatusLog[]
  seatingTables SeatingTable[]

  @@index([customerId])
  @@index([status])
  @@index([reference])
  @@index([accessCodeHash])
}

// ---------------------------------------------------------------------------
// SEATING PLANNER (Optional Phase 8 feature)
// ---------------------------------------------------------------------------

/// Tables created for an order / invitation to seat confirmed guests
model SeatingTable {
  id          String   @id @default(cuid())
  orderId     String
  name        String   // e.g. "Table 1 - Orchids", "VIP Presidential Table"
  capacity    Int      @default(8)
  shape       String   @default("round") // round, rectangular
  notes       String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  assignments SeatingAssignment[]

  @@index([orderId])
}

/// Assignment of a guest / RSVP to a table
model SeatingAssignment {
  id          String       @id @default(cuid())
  tableId     String
  guestName   String
  rsvpId      String?
  seatNumber  Int?
  notes       String?
  createdAt   DateTime     @default(now())

  table       SeatingTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId])
  @@index([rsvpId])
}

/// A price quotation presented to the customer for approval.
model Quotation {
  id             String          @id @default(cuid())
  orderId        String
  amountCentavos Int
  currency       String          @default("PHP")
  description    String?
  validUntil     DateTime?
  status         QuotationStatus @default(PENDING)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Payment record — never stores raw card data.
/// Records payment reference, timestamps, and provider-confirmed status.
model PaymentRecord {
  id                String        @id @default(cuid())
  orderId           String
  providerReference String?       // provider transaction ID
  method            String?       // e.g. "gcash", "bank_transfer", "manual"
  amountCentavos    Int
  currency          String        @default("PHP")
  status            PaymentStatus @default(PENDING)
  verifiedAt        DateTime?
  verifiedByUserId  String?
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([status])
}

/// Customer-initiated revision request for a custom-service order.
model RevisionRequest {
  id          String               @id @default(cuid())
  orderId     String
  description String
  status      RevisionRequestStatus @default(PENDING)
  adminNotes  String?
  createdAt   DateTime             @default(now())
  resolvedAt  DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

/// Append-only audit trail for important order status transitions.
model OrderStatusLog {
  id         String      @id @default(cuid())
  orderId    String
  fromStatus OrderStatus?
  toStatus   OrderStatus
  note       String?
  actorId    String?     // userId who performed the action
  createdAt  DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

// ---------------------------------------------------------------------------
// BUSINESS CONFIGURATION
// ---------------------------------------------------------------------------

/// Key-value store for editable business settings (packages, pricing, policies).
/// Values are stored as JSON strings to support rich configuration.
model BusinessSetting {
  key       String   @id
  value     String   // JSON-encoded value
  updatedAt DateTime @updatedAt
  updatedBy String?  // userId of last admin to update
}

// ---------------------------------------------------------------------------
// AUDIT LOG
// ---------------------------------------------------------------------------

/// Append-only log of important administrative actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  action     String   // e.g. "ORDER_STATUS_CHANGED", "INVITATION_PUBLISHED"
  entityType String   // e.g. "Order", "Invitation"
  entityId   String
  detail     String?  // JSON
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  ADMIN
}

enum InvitationStatus {
  DRAFT
  PREVIEW_READY  // visible only to owner via protected preview link
  PUBLISHED      // publicly accessible at /i/[publicSlug]
  ARCHIVED
}

enum RSVPResponse {
  ATTENDING
  UNABLE_TO_ATTEND
  AWAITING
}

enum InquiryStatus {
  NEW
  REVIEWED
  CONVERTED  // linked to an Order
  ARCHIVED
}

enum OrderType {
  SELF_SERVICE   // customer uses the template builder
  CUSTOM_SERVICE // MERCI team creates a bespoke invitation
}

enum OrderStatus {
  INQUIRY
  QUOTATION_PENDING
  AWAITING_CUSTOMER_APPROVAL
  AWAITING_PAYMENT
  PAID
  IN_PROGRESS
  PREVIEW_READY
  REVISION_REQUESTED
  APPROVED
  PUBLISHED
  COMPLETED
  CANCELLED
  REFUNDED
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  CANCELLED
}

enum RevisionRequestStatus {
  PENDING
  IN_PROGRESS
  RESOLVED
  REJECTED
}
