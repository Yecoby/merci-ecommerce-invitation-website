# MERCI Platform - Environment Configuration Example
# Copy this file to .env and adjust the values for your local environment.
# Never commit real secrets or production .env files to source control.

# Database
# DB_PROVIDER controls which database Prisma uses.
# Use "sqlite" for zero-config local development, "postgresql" for production.
DB_PROVIDER="sqlite"
# Local SQLite for immediate zero-config testing/dev:
DATABASE_URL="file:./dev.db"
# Or PostgreSQL for production / cloud DB:
# DB_PROVIDER="postgresql"
# DATABASE_URL="postgresql://merci_user:merci_pass@localhost:5432/merci_db?schema=public"

# Auth.js / NextAuth
# Generate a secret via: `openssl rand -base64 33` or any 32+ character random string
AUTH_SECRET="merci-development-secret-change-in-production-min-32-chars-long"
AUTH_URL="http://localhost:3000"
NEXTAUTH_URL="http://localhost:3000"

# Public Site Configuration
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="MERCI Digital Invitations"
NEXT_PUBLIC_DEFAULT_CURRENCY="PHP"
NEXT_PUBLIC_DEFAULT_CURRENCY_SYMBOL="₱"

# Business Information (Configurable Sample Values)
NEXT_PUBLIC_BUSINESS_NAME="MERCI Digital Invitations"
NEXT_PUBLIC_CONTACT_EMAIL="hello@merci-invitations.ph"
NEXT_PUBLIC_CONTACT_PHONE="+63 917 000 0000"
NEXT_PUBLIC_BUSINESS_HOURS="Monday to Saturday, 9:00 AM – 6:00 PM PHT"

# Optional Email Service (Resend / SendGrid / SMTP)
# When not set, the platform uses development console logging for notifications
# EMAIL_SERVER_USER=""
# EMAIL_SERVER_PASSWORD=""
# EMAIL_SERVER_HOST="smtp.example.com"
# EMAIL_SERVER_PORT="587"
# EMAIL_FROM="MERCI <noreply@merci-invitations.ph>"

# Optional External Storage (AWS S3 / Cloudflare R2)
# When not set, the platform uses local file storage or safe inline preview assets
# STORAGE_BUCKET=""
# STORAGE_REGION=""
# STORAGE_ACCESS_KEY_ID=""
# STORAGE_SECRET_ACCESS_KEY=""
